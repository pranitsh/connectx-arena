rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read and write only their own user doc
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users can read (but NOT write) their own read-only doc
    match /usersReadOnly/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // only allow server-side (Admin SDK/Cloud Functions)
    }

    // Rate limiting documents (managed entirely server-side by Python functions via Admin SDK)
    match /rate_limits/{userId} {
      allow read, write: if false;
    }
  }
}